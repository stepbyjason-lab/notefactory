# Copy this file to .env.local and add only the provider keys you intend to use.
# .env.local is ignored by Git and must never be committed.

# Required for the default free writer path.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated provider:model priority lists. Leftmost route is tried first.
WRITER_CANDIDATES=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,openrouter:google/gemma-4-31b-it:free
CRITIC_CANDIDATES=gemini:gemma-4-31b-it,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash-lite

# Optional free fallback via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# This public starter intentionally contains only free routes. If you manually add
# a provider whose account bills, that explicit configuration may incur charges.
# Developer-only CLI subscription fallback is not part of the portable public setup.
