# 시크릿 (절대 커밋 금지)
.env
.env.*
!.env.example

# 산출물/작업
notes_out/
scratchpad/
*.note.md.tmp
.out/
dist/
.tmp/

# python
__pycache__/
*.pyc
.venv/

# round-16 계약 §3.3.1 — madi usage-guard fail-open 연속 카운터 상태(runtime
# 산출물). 자체 opt-in sentinel(.madi/usage-guard.enabled)은 ignore하지 않는다.
.madi/usage-guard.fail-open-state.json

# 모델 헬스 캐시·알림 (하루 1회 갱신, 재현 가능한 산출물 아님)
.cache/

# Madi 훅의 턴 종료 상태(세션별 런타임 산출물)
.madi/turn-end/

# Claude Code 로컬 상태(개인 권한 허용·예약 작업 잠금). 이 기계의 전역 ignore와
# .git/info/exclude에만 걸려 있어 다른 클론에서는 노출되므로 레포에서 막는다.
.claude/settings.local.json
.claude/scheduled_tasks.lock
